{
  "name": "app-disfraces-mz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.js",
    "test:functions": "firebase emulators:exec --only firestore --project demo-disfraces-mz \"npm --prefix functions test\"",
    "test:emulators": "firebase emulators:exec --only firestore,storage --project demo-disfraces-mz \"npm run test:rules && npm --prefix functions test\"",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage",
    "firebase:deploy": "npm run build && firebase deploy"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "sweetalert": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.26.0",
    "globals": "^17.10.0",
    "jsdom": "^29.1.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
