# La configuración web de Firebase identifica el proyecto, pero no concede acceso
# por sí sola. Copia este archivo como .env.local y completa los valores desde
# Firebase Console > Configuración del proyecto > Tus apps > SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=react-firebase-3f563.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=react-firebase-3f563
VITE_FIREBASE_STORAGE_BUCKET=react-firebase-3f563.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=138707644770
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Ponlo en true cuando quieras trabajar completamente contra los emuladores.
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_FIREBASE_APP_CHECK=false
VITE_FIREBASE_APP_CHECK_SITE_KEY=
